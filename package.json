{
  "name": "frontend-tooling-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp build",
    "preview": "vp preview --host 127.0.0.1",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test",
    "test:run": "vp test run",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "test:e2e:ui": "npm run build && node scripts/run-e2e.mjs --ui",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "verify": "npm run check && npm run test:run",
    "preflight": "node scripts/preflight.mjs",
    "toolchain": "vp toolchain"
  },
  "dependencies": {
    "@axa-fr/canopee-css": "^1.8.0",
    "@axa-fr/canopee-react": "^1.8.0",
    "@material-symbols/svg-400": "^0.47.6",
    "@material-symbols/svg-700": "^0.47.6",
    "msw": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxc-minify": "0.152.0",
    "oxc-parser": "0.152.0",
    "oxc-resolver": "11.24.2",
    "oxc-transform": "0.152.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
